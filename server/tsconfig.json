{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true
  },
  "include": ["src"],
  // Tests are typechecked (tsconfig.check.json) but never emitted: the image runs
  // dist/index.js, and a spec beside it is dead weight in a deployment.
  "exclude": ["src/**/*.test.ts"]
}
